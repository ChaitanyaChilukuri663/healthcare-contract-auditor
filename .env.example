# ---------------------------------------------------------------------------
# Healthcare Contract Auditor — environment configuration
# Copy to `.env` and fill in. NEVER commit a real `.env` (it is gitignored).
# Only LLM_PROVIDER + GITHUB_TOKEN are required to start the service and run the
# LLM/extraction paths. The Azure_* values are needed for the full audit pipeline.
# ---------------------------------------------------------------------------

# ========================= LLM provider (required) =========================
# OpenAI-compatible backend: github | azure | groq. All LLM calls route through
# agents/llm_client.py based on this.
LLM_PROVIDER=github

# Optional chat model override. Defaults: github->gpt-4o-mini, groq->llama-3.3-70b-versatile.
# LLM_MODEL=gpt-4o-mini

# Embedding model (used for AI Search vectors). GitHub Models hosts this too.
EMBEDDING_MODEL=text-embedding-3-small

# --- GitHub Models (primary/dev) — REQUIRED when LLM_PROVIDER=github --------
# Create at https://github.com/settings/tokens (fine-grained or classic; no scopes
# needed for Models). Free tier: 150 req/day on gpt-4o-mini.
GITHUB_TOKEN=ghp_your_personal_access_token_here

# --- Azure OpenAI — only when LLM_PROVIDER=azure ---------------------------
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_KEY=your_azure_openai_key
# AZURE_OPENAI_DEPLOYMENT=your-gpt-4o-mini-deployment
# AZURE_OPENAI_API_VERSION=2024-10-21

# --- Groq — only when LLM_PROVIDER=groq ------------------------------------
# GROQ_API_KEY=gsk_your_groq_api_key

# ========================= Azure services (pipeline) =======================
# Required for POST /audit_contract. Without them the service still starts and
# serves /health; the audit endpoint returns 503.

# --- Azure AI Search ---
AZURE_SEARCH_ENDPOINT=https://your-search.search.windows.net
AZURE_SEARCH_KEY=your_search_admin_key
AZURE_SEARCH_INDEX=contract-chunks

# --- Azure Blob Storage (use ONE of connection string or account URL+identity) ---
AZURE_BLOB_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net
# AZURE_BLOB_ACCOUNT_URL=https://youraccount.blob.core.windows.net
BLOB_CONTAINER=contracts

# --- Azure SQL (use the full connection string OR the components) ---
# AZURE_SQL_CONNECTION_STRING=DRIVER={ODBC Driver 18 for SQL Server};SERVER=...;DATABASE=...;UID=...;PWD=...;Encrypt=yes;
AZURE_SQL_SERVER=your-sql-server.database.windows.net
AZURE_SQL_DATABASE=hca
AZURE_SQL_USERNAME=your_sql_admin
AZURE_SQL_PASSWORD=your_sql_password
AZURE_SQL_DRIVER={ODBC Driver 18 for SQL Server}

# --- Key Vault / identity (prod) ---
# AZURE_KEYVAULT_URI=https://your-vault.vault.azure.net/
# USE_MANAGED_IDENTITY=false

# ========================= Application tuning (optional) ===================
APP_NAME=healthcare-contract-auditor
AUDIT_CONCURRENCY=1
REQUEST_TIMEOUT_SECONDS=60

# Embeddings / chunking
EMBEDDING_DIMENSIONS=1536
CHUNK_MAX_TOKENS=500
CHUNK_OVERLAP_TOKENS=80

# Validation tolerances (Stage 5)
PERCENT_TOLERANCE=0.5
AMOUNT_TOLERANCE=0.01
DEFAULT_LOCALITY=0000000
